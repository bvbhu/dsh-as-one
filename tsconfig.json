{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "baseUrl": ".",
    "paths": {
      "@as-one/core/src/*.js": [
        "./core/*.ts"
      ],
      "@as-one/core": [
        "./core/index.ts"
      ],
      "@as-one/panel/src/*.js": [
        "./panel/*.ts"
      ],
      "@as-one/panel": [
        "./panel/index.ts"
      ],
      "@as-one/panel-ui/src/*.js": [
        "./panel-ui/*.ts"
      ],
      "@as-one/panel-ui": [
        "./panel-ui/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "core",
    "panel",
    "panel-ui",
    "test"
  ]
}
